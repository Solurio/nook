# Supabase project settings -> Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: gif/sticker search. Add either or both -- the panel searches every
# source you configure at once. Giphy: developers.giphy.com. Klipy:
# partner.klipy.com. Leave them out and the app runs fine without the picker.
NEXT_PUBLIC_GIPHY_KEY=
NEXT_PUBLIC_KLIPY_KEY=
